---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/lib/url';
---

<BaseLayout title="Page not found">
  <section class="container-page grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="font-display text-8xl font-bold text-accent">404</p>
      <h1 class="mt-4 text-3xl font-bold text-brand">This page could not be found</h1>
      <p class="mt-3 text-muted">It may have moved when we rebuilt the website.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href={url('/')} class="btn btn-primary">
          Go home
        </a>
        <a href={url('/contact-us/')} class="btn btn-ghost">
          Contact us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
