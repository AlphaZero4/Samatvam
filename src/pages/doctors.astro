---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import { doctors, counsellors, type Person } from '@/data/content';
import { url } from '@/lib/url';

const groups: { id: string; title: string; eyebrow: string; people: Person[] }[] = [
  { id: 'doctors', eyebrow: 'Endocrinology Diabetes', title: 'Doctors', people: doctors },
  {
    id: 'counsellors',
    eyebrow: 'Counsellors: Diabetes Education',
    title: 'Physician Assistants, Endocrinology Diabetes',
    people: counsellors,
  },
];
---

<BaseLayout
  title="Doctors"
  description="Samatvam's team of endocrinologists, diabetologists, diabetes educators and physician assistants."
>
  <PageHero
    eyebrow="Doctors"
    title="Eminence and Excellence"
    lead="Nationally and internationally trained specialists in endocrinology and diabetes, supported by certified diabetes educators. Multidisciplinary team care ensures optimal health outcomes."
    vtName="title-doctors"
  >
    <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-i:2">
      <a href="#doctors" class="btn btn-primary">
        {doctors.length} doctors
      </a>
      <a href="#counsellors" class="btn btn-ghost">
        {counsellors.length} counsellors & PAs
      </a>
    </div>
  </PageHero>

  <div class="container-page space-y-20 py-16">
    {groups.map((g) => (
      <section id={g.id} aria-labelledby={`${g.id}-title`} class="scroll-mt-32">
        <div data-reveal>
          <p class="eyebrow">{g.eyebrow}</p>
          <h2 id={`${g.id}-title`} class="mt-2 text-3xl font-bold text-brand sm:text-4xl">
            {g.title}
          </h2>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.people.map((p, i) => {
            const inner = (
              <>
                <span
                  class="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-brand/15 to-accent/15 font-display text-lg font-bold text-brand transition duration-500 ease-out-expo group-hover:scale-105 group-hover:rotate-[-4deg]"
                  aria-hidden="true"
                >
                  {p.initials}
                </span>
                <span class="min-w-0">
                  <span class="block font-display text-lg leading-tight font-semibold">{p.name}</span>
                  <span class="mt-1 block text-sm leading-snug text-muted">{p.credentials}</span>
                  {p.href && (
                    <span class="mt-2 inline-block text-sm font-semibold text-accent-strong dark:text-accent">
                      View profile →
                    </span>
                  )}
                </span>
              </>
            );
            const cls =
              'group card flex h-full items-start gap-4 p-5 transition duration-500 ease-out-expo hover:-translate-y-1 hover:border-accent/60';
            return (
              <li data-reveal style={`--reveal-i:${i % 6}`}>
                {p.href ? (
                  <a href={url(p.href)} class={cls}>
                    {inner}
                  </a>
                ) : (
                  <div class={cls}>{inner}</div>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
  <RelatedLinks />
</BaseLayout>
