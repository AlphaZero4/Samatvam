---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const d = page.data;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={d.title} description={d.description}>
  <PageHero
    eyebrow={d.title}
    title={d.heading}
    lead={d.lead}
    image={d.image}
    imageAlt={d.imageAlt}
    vtName={`title-${page.id}`}
    crumbs={d.parent ? [d.parent] : []}
  />

  <div class:list={['container-page grid gap-12 py-14', toc.length > 2 && 'lg:grid-cols-[220px_1fr]']}>
    {toc.length > 2 && (
      <aside class="hidden lg:block">
        <nav aria-label="On this page" class="sticky top-32">
          <p class="eyebrow mb-3">On this page</p>
          <ul class="space-y-2 border-l border-line text-sm">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="-ml-px block border-l-2 border-transparent py-0.5 pl-4 text-muted transition hover:border-accent hover:text-fg"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
    <article
      class:list={[
        'prose prose-slate md:prose-lg dark:prose-invert max-w-none prose-samatvam',
        d.gridLists && 'prose-grid-lists',
      ]}
      data-reveal
    >
      <Content />
    </article>
  </div>

  <RelatedLinks current={`/${page.id}/`} />
</BaseLayout>
