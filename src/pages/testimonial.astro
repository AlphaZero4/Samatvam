---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import { testimonials } from '@/data/testimonials';
---

<BaseLayout
  title="Testimonials"
  description="Patients describe their experience of care at Samatvam – Jnana Sanjeevini."
>
  <PageHero
    eyebrow="Testimonials"
    title="In our patients’ words"
    lead="“It is difficult to call it a hospital or a clinic. It is more like a temple or even one's mother's home where all worries are forgotten.”"
    vtName="title-testimonial"
  />

  <div class="container-page columns-1 gap-6 py-16 lg:columns-2">
    {testimonials.map((t, i) => (
      <figure class="card mb-6 break-inside-avoid p-8" data-reveal style={`--reveal-i:${i % 2}`}>
        <svg viewBox="0 0 32 32" class="size-9 text-accent/40" fill="currentColor" aria-hidden="true">
          <path d="M10 8c-4 2-7 6-7 11v5h9v-9H7c0-3 2-5 4-6zm16 0c-4 2-7 6-7 11v5h9v-9h-5c0-3 2-5 4-6z" />
        </svg>
        <blockquote class="mt-4 space-y-4 leading-relaxed text-fg/90">
          {t.text.split('\n\n').map((p) => (
            <p>{p}</p>
          ))}
        </blockquote>
        <figcaption class="mt-6 border-t border-line pt-5">
          <p class="font-display text-xl font-semibold text-brand">{t.name}</p>
          <p class="mt-1 text-sm text-muted">{[t.profile, t.occupation].filter(Boolean).join(' · ')}</p>
          <p class="mt-3 flex flex-wrap gap-2 text-xs">
            {t.firstVisit && (
              <span class="rounded-full bg-bg-soft px-3 py-1">First visit: {t.firstVisit}</span>
            )}
            {t.date && <span class="rounded-full bg-bg-soft px-3 py-1">Written {t.date}</span>}
          </p>
        </figcaption>
      </figure>
    ))}
  </div>
  <RelatedLinks current="/testimonial/" />
</BaseLayout>
