---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { heroSlides, quickActions, highlights, introCards } from '@/data/content';
import { exploreNav, locations, tel } from '@/data/site';
import { media } from '@/lib/media';
import { url } from '@/lib/url';

const actionIcons: Record<string, string> = {
  Membership: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 9a7 7 0 0 1 14 0',
  Appointments: 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
  'Ask Your Doctor': 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z',
  Teleconsultation: 'M15 10l5-3v10l-5-3M4 6h11v12H4z',
  Helplines: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
};
---

<BaseLayout>
  <!-- Hero slideshow -->
  <section
    class="relative isolate overflow-hidden bg-navy text-white"
    aria-roledescription="carousel"
    aria-label="Highlights"
    data-slideshow
    tabindex="0"
  >
    <div class="relative h-[78svh] min-h-[520px] lg:h-[86svh]">
      {heroSlides.map((s, i) => (
        <article
          class:list={['slide absolute inset-0', i === 0 && 'is-active']}
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${heroSlides.length}`}
          data-slide
        >
          <Image
            src={media(s.image)}
            alt=""
            widths={[640, 1024, 1440, 1800]}
            sizes="100vw"
            class="absolute inset-0 size-full object-cover"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0b1730] via-[#0b1730]/55 to-[#0b1730]/10" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#0b1730]/70 via-transparent to-transparent" />
          <div class="slide-copy container-page relative flex h-full flex-col justify-end pb-28 lg:pb-32">
            <p class="eyebrow !text-[#ffb08a]">
              {String(i + 1).padStart(2, '0')} / {String(heroSlides.length).padStart(2, '0')}
            </p>
            <h2 class="mt-3 max-w-3xl text-4xl leading-[1.02] font-bold sm:text-5xl lg:text-7xl">
              {s.title}
            </h2>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/85 sm:text-lg">{s.text}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="absolute inset-x-0 bottom-0">
      <div class="container-page flex items-center justify-between gap-6 pb-8">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Choose slide">
          {heroSlides.map((s, i) => (
            <button
              type="button"
              class="dot h-1.5 w-3 rounded-full bg-white/35 transition-all duration-500 hover:bg-white/70 aria-[current=true]:w-8 aria-[current=true]:bg-white sm:w-6 sm:aria-[current=true]:w-12"
              aria-label={`Show slide ${i + 1}: ${s.title}`}
              aria-current={i === 0 ? 'true' : 'false'}
              data-slide-dot
            />
          ))}
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            class="grid size-11 place-items-center rounded-full border border-white/30 backdrop-blur transition hover:bg-white hover:text-navy"
            aria-label="Previous slide"
            data-slide-prev
          >
            ←
          </button>
          <button
            type="button"
            class="grid size-11 place-items-center rounded-full border border-white/30 backdrop-blur transition hover:bg-white hover:text-navy"
            aria-label="Next slide"
            data-slide-next
          >
            →
          </button>
        </div>
      </div>
      <div class="h-0.5 w-full bg-white/10">
        <div class="slide-progress h-full bg-accent" data-slide-progress></div>
      </div>
    </div>
  </section>

  <!-- Quick actions -->
  <section class="container-page relative z-10 -mt-10" aria-label="Quick actions">
    <ul class="card grid grid-cols-2 gap-px overflow-hidden bg-line sm:grid-cols-3 lg:grid-cols-5">
      {quickActions.map((a, i) => (
        <li class:list={['bg-bg-elev', i === quickActions.length - 1 && 'col-span-2 sm:col-span-1']}>
          <button
            type="button"
            class="group flex w-full flex-col items-start gap-3 px-4 py-4 text-left transition hover:bg-bg-soft sm:flex-row sm:items-center sm:px-5 sm:py-5"
            data-coming-soon-trigger={a}
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent transition duration-500 ease-out-expo group-hover:scale-110 group-hover:rotate-[-6deg] group-hover:bg-accent group-hover:text-white">
              <svg
                viewBox="0 0 24 24"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={actionIcons[a]} />
              </svg>
            </span>
            <span class="text-sm font-semibold sm:text-base">{a}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <!-- Highlights -->
  <section class="container-page py-20" aria-label="At a glance">
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {highlights.map((h, i) => (
        <li data-reveal style={`--reveal-i:${i}`} class="border-l-2 border-accent pl-5">
          <p class="font-display text-5xl font-bold text-brand">{h.value}</p>
          <p class="mt-2 text-sm text-muted">{h.label}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Intro cards -->
  <section class="bg-bg-soft py-20" aria-labelledby="who-title">
    <div class="container-page">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Who we are</p>
        <h2 id="who-title" class="mt-3 text-4xl font-bold text-brand sm:text-5xl">
          Bridging the best of East and West
        </h2>
        <p class="mt-4 text-lg text-muted">
          The central philosophy is the harmonious integration of science and spirituality in the context of
          health care.
        </p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {introCards.map((c, i) => (
          <a
            href={url(c.href)}
            class="group card relative flex flex-col overflow-hidden p-8 transition duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-xl"
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-accent to-leaf transition duration-700 ease-out-expo group-hover:scale-x-100" />
            <p class="eyebrow">{c.label}</p>
            <h3 class="mt-2 text-3xl font-bold text-brand">{c.name}</h3>
            <p class="mt-4 flex-1 leading-relaxed text-muted">{c.text}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-accent-strong dark:text-accent">
              Know more <span class="transition group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Explore -->
  <section class="container-page py-20" aria-labelledby="explore-title">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="eyebrow">Explore</p>
        <h2 id="explore-title" class="mt-3 text-4xl font-bold text-brand sm:text-5xl">
          More about Samatvam
        </h2>
      </div>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {exploreNav.map((n, i) => (
        <li data-reveal style={`--reveal-i:${i % 4}`}>
          <a
            href={url(n.href)}
            class="group flex h-full flex-col justify-between rounded-2xl border border-line bg-bg-elev p-6 transition duration-500 ease-out-expo hover:-translate-y-1 hover:border-accent hover:shadow-card"
          >
            <span>
              <span
                class="block font-display text-xl font-semibold"
                transition:name={`title-${n.href.replaceAll('/', '')}`}
              >
                {n.label}
              </span>
              <span class="mt-1 block text-sm text-muted">{n.blurb}</span>
            </span>
            <span
              class="mt-6 grid size-9 place-items-center rounded-full bg-bg-soft text-accent transition duration-500 ease-out-expo group-hover:translate-x-1 group-hover:bg-accent group-hover:text-white"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Helpline banner -->
  <section class="container-page" aria-labelledby="help-title">
    <div
      class="relative overflow-hidden rounded-[2rem] bg-navy px-8 py-12 text-white md:px-14 md:py-16"
      data-reveal
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-accent/30 blur-3xl"
      ></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-32 left-10 size-80 rounded-full bg-sky/20 blur-3xl"
      ></div>
      <div class="relative grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div>
          <p class="eyebrow !text-[#ffb08a]">Free since 1994</p>
          <h2 id="help-title" class="mt-3 text-4xl font-bold sm:text-5xl">
            24 × 7 diabetes helplines
          </h2>
          <p class="mt-4 max-w-lg text-white/80">
            Telephone, WhatsApp and email support from our doctors and counsellors: emergency diabetes care,
            hospital admissions and general queries.
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {locations.map((l) => (
            <li>
              <a
                href={tel(l.helpline)}
                class="block rounded-2xl border border-white/15 bg-white/5 p-5 backdrop-blur transition duration-500 ease-out-expo hover:-translate-y-0.5 hover:bg-white hover:text-navy"
              >
                <span class="text-sm opacity-75">{l.area}</span>
                <span class="mt-1 block font-display text-2xl font-semibold tabular-nums">{l.helpline}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .slide-progress {
    width: 0;
    animation: progress 6.5s linear forwards;
  }
  [data-slideshow]:hover .slide-progress,
  [data-slideshow]:focus-within .slide-progress {
    animation-play-state: paused;
  }
  @keyframes progress {
    to {
      width: 100%;
    }
  }
</style>
