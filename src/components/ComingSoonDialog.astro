---
// The original site showed a "Coming Soon" modal for Membership, Appointments, etc.
// We keep that, but point people at the helplines so the dialog is still useful.
import { locations, tel } from '@/data/site';
import { url } from '@/lib/url';
---

<dialog
  class="coming-soon m-auto w-[min(92vw,28rem)] rounded-3xl border border-line bg-bg-elev p-0 text-fg shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
  aria-labelledby="coming-soon-title"
  data-coming-soon
>
  <div class="p-7">
    <p class="eyebrow" data-coming-soon-label>
      Coming soon
    </p>
    <h2 id="coming-soon-title" class="mt-2 text-3xl font-bold text-brand">
      Coming Soon…
    </h2>
    <p class="mt-3 text-muted">
      Online booking is on its way. Until then, our teams are a phone call away, 24 hours a day.
    </p>
    <ul class="mt-5 space-y-2">
      {locations.map((l) => (
        <li>
          <a
            href={tel(l.helpline)}
            class="flex items-center justify-between rounded-xl border border-line px-4 py-3 transition hover:border-accent hover:text-accent"
          >
            <span>{l.area}</span>
            <span class="font-semibold tabular-nums">{l.helpline}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-6 flex gap-3">
      <a href={url('/contact-us/')} class="btn btn-primary">
        Contact us
      </a>
      <button type="button" class="btn btn-ghost" data-dialog-close>
        Close
      </button>
    </div>
  </div>
</dialog>

<style>
  .coming-soon[open] {
    animation: pop 0.45s var(--ease-out-expo);
  }
  .coming-soon[open]::backdrop {
    animation: fade 0.3s ease;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>
