---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '@/lib/url';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Shared view-transition name so a card on another page can morph into this title. */
  vtName?: string;
  crumbs?: { label: string; href?: string }[];
}

const { eyebrow, title, lead, image, imageAlt = '', vtName, crumbs = [] } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div aria-hidden="true" class="hero-glow pointer-events-none absolute inset-0"></div>
  <div
    class:list={[
      'container-page relative grid items-center gap-10 py-14 md:py-20',
      image && 'lg:grid-cols-[1.15fr_0.85fr]',
    ]}
  >
    <div>
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted" data-reveal>
        <ol class="flex flex-wrap items-center gap-1.5">
          <li>
            <a href={url('/')} class="transition hover:text-accent">
              Home
            </a>
          </li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-1.5">
              <span aria-hidden="true">/</span>
              {c.href ? (
                <a href={url(c.href)} class="transition hover:text-accent">
                  {c.label}
                </a>
              ) : (
                <span>{c.label}</span>
              )}
            </li>
          ))}
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true">/</span>
            <span aria-current="page" class="text-fg">
              {eyebrow}
            </span>
          </li>
        </ol>
      </nav>
      <p class="eyebrow" data-reveal>
        {eyebrow}
      </p>
      <h1
        class="mt-3 max-w-3xl text-4xl leading-[1.05] font-bold text-brand sm:text-5xl lg:text-6xl"
        transition:name={vtName}
      >
        {title}
      </h1>
      {lead && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted" data-reveal style="--reveal-i:1">
          {lead}
        </p>
      )}
      <slot />
    </div>
    {image && (
      <div data-reveal style="--reveal-i:2" class="relative">
        <div class="absolute -inset-4 -z-10 rotate-2 rounded-[2rem] bg-accent/10" />
        <Image
          src={image}
          alt={imageAlt}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="max-h-[420px] w-full rounded-[1.75rem] border border-line bg-white object-contain shadow-card"
          loading="eager"
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero-glow {
    background:
      radial-gradient(
        60rem 30rem at 85% -10%,
        color-mix(in oklab, var(--accent) 16%, transparent),
        transparent 60%
      ),
      radial-gradient(
        40rem 24rem at -10% 110%,
        color-mix(in oklab, var(--sky) 18%, transparent),
        transparent 60%
      );
  }
</style>
