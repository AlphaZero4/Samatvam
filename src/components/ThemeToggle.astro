---
// Light/dark toggle. Behaviour lives in src/scripts/ui.ts (delegated click handler),
// so it keeps working across view-transition page swaps.
---

<button
  type="button"
  class="theme-toggle relative grid size-10 place-items-center overflow-hidden rounded-full border border-line bg-bg-elev text-fg transition hover:border-accent hover:text-accent"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  data-theme-toggle
>
  <svg
    class="sun absolute size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="moon absolute size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"></path>
  </svg>
</button>

<style>
  .theme-toggle svg {
    transition:
      transform 0.6s var(--ease-out-expo),
      opacity 0.4s var(--ease-out-expo);
  }
  .sun {
    transform: rotate(0deg) scale(1);
  }
  .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
  :global(.dark) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }
  :global(.dark) .moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>
