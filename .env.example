# Public, build-time settings (anything PUBLIC_* ships to the browser).

# Where the contact form sends. If empty, the form opens a pre-filled email to CONTACT_EMAIL.
# Any endpoint that accepts a JSON POST works (e.g. Formspree, Web3Forms, your own API).
PUBLIC_FORM_ENDPOINT=
PUBLIC_CONTACT_EMAIL=samatvam@gmail.com

# Hosting. Defaults target https://alphazero4.github.io/Samatvam/.
# For a custom domain (e.g. samatvam.org) set SITE_URL=https://samatvam.org and SITE_BASE=/
SITE_URL=https://alphazero4.github.io
SITE_BASE=/Samatvam
