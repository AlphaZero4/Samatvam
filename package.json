{
  "name": "samatvam-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Samatvam Endocrinology Diabetes / Jnana Sanjeevini website. Astro + Tailwind CSS, deployed to GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-links.mjs dist",
    "ci": "npm run format:check && npm run check && npm run build && npm run check:links"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "~7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  }
}
